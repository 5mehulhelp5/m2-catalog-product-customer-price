<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="catalog_product_customer_price" resource="default" engine="innodb" comment="Customer Prices of Products">
        <column xsi:type="int" name="id" padding="10" unsigned="true" nullable="false" identity="true" comment="ID"/>
        <column xsi:type="int" name="customer_id" padding="10" unsigned="true" nullable="false" comment="Customer ID"/>
        <column xsi:type="int" name="product_id" padding="10" unsigned="true" nullable="false" comment="Product ID"/>
        <column xsi:type="decimal" name="price" scale="2" precision="20" unsigned="false" nullable="true" comment="Price"/>
        <column xsi:type="smallint" name="discount" padding="5" unsigned="true" nullable="true" comment="Discount in Percent"/>
        <column xsi:type="smallint" name="limit" padding="5" unsigned="true" nullable="true" comment="Limit of the Quantity"/>
        <column xsi:type="smallint" name="priority" padding="6" unsigned="false" nullable="false" default="100" comment="Priority"/>
        <column xsi:type="smallint" name="website_id" padding="5" unsigned="true" nullable="false" default="0" comment="Website ID"/>
        <column xsi:type="smallint" name="used" padding="5" unsigned="true" nullable="true" default="0" comment="Used Quantity"/>
        <column xsi:type="smallint" name="active" padding="5" unsigned="true" nullable="false" default="0" comment="Active"/>
        <column xsi:type="datetime" name="created_at" on_update="false" nullable="false" comment="Creation Time"/>
        <column xsi:type="datetime" name="updated_at" on_update="false" nullable="false" comment="Update Time"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="CATALOG_PRODUCT_CUSTOMER_PRICE_CUSTOMER_ID_CUSTOMER_ENTITY_ENTITY_ID" table="catalog_product_customer_price" column="customer_id" referenceTable="customer_entity" referenceColumn="entity_id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="CATALOG_PRODUCT_CUSTOMER_PRICE_PRODUCT_ID_CATALOG_PRODUCT_ENTITY_ENTITY_ID" table="catalog_product_customer_price" column="product_id" referenceTable="catalog_product_entity" referenceColumn="entity_id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="CATALOG_PRODUCT_CUSTOMER_PRICE_WEBSITE_ID_STORE_WEBSITE_WEBSITE_ID" table="catalog_product_customer_price" column="website_id" referenceTable="store_website" referenceColumn="website_id" onDelete="CASCADE"/>
    </table>
</schema>
